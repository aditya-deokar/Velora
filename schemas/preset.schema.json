{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "kind": {
          "type": "string",
          "const": "motion"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "body": {
          "type": "object",
          "properties": {
            "values": {
              "default": "relative",
              "type": "string",
              "enum": [
                "absolute",
                "relative"
              ]
            },
            "durationMs": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 600000
            },
            "ease": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "linear",
                    "easeInOut",
                    "cinematic",
                    "hold",
                    "sine.in",
                    "sine.out",
                    "sine.inOut",
                    "quad.in",
                    "quad.out",
                    "quad.inOut",
                    "cubic.in",
                    "cubic.out",
                    "cubic.inOut",
                    "quart.in",
                    "quart.out",
                    "quart.inOut",
                    "quint.in",
                    "quint.out",
                    "quint.inOut",
                    "expo.in",
                    "expo.out",
                    "expo.inOut",
                    "circ.in",
                    "circ.out",
                    "circ.inOut",
                    "back.in",
                    "back.out",
                    "back.inOut",
                    "elastic.in",
                    "elastic.out",
                    "elastic.inOut",
                    "bounce.in",
                    "bounce.out",
                    "bounce.inOut"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "cubicBezier": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": -5,
                          "maximum": 5
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "number",
                          "minimum": -5,
                          "maximum": 5
                        }
                      ]
                    }
                  },
                  "required": [
                    "cubicBezier"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "spring": {
                      "type": "object",
                      "properties": {
                        "stiffness": {
                          "default": 170,
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 10000
                        },
                        "damping": {
                          "default": 26,
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1000
                        },
                        "mass": {
                          "default": 1,
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 100
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "spring"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "steps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 240
                    },
                    "jump": {
                      "default": "end",
                      "type": "string",
                      "enum": [
                        "start",
                        "end"
                      ]
                    }
                  },
                  "required": [
                    "steps"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "replace",
                "add"
              ]
            },
            "tracks": {
              "default": [],
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "clips": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "title",
        "kind",
        "body"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "kind": {
          "type": "string",
          "const": "easing"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "body": {
          "type": "object",
          "properties": {
            "curves": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "easing": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "linear",
                          "easeInOut",
                          "cinematic",
                          "hold",
                          "sine.in",
                          "sine.out",
                          "sine.inOut",
                          "quad.in",
                          "quad.out",
                          "quad.inOut",
                          "cubic.in",
                          "cubic.out",
                          "cubic.inOut",
                          "quart.in",
                          "quart.out",
                          "quart.inOut",
                          "quint.in",
                          "quint.out",
                          "quint.inOut",
                          "expo.in",
                          "expo.out",
                          "expo.inOut",
                          "circ.in",
                          "circ.out",
                          "circ.inOut",
                          "back.in",
                          "back.out",
                          "back.inOut",
                          "elastic.in",
                          "elastic.out",
                          "elastic.inOut",
                          "bounce.in",
                          "bounce.out",
                          "bounce.inOut"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "cubicBezier": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "number",
                                "minimum": -5,
                                "maximum": 5
                              },
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "number",
                                "minimum": -5,
                                "maximum": 5
                              }
                            ]
                          }
                        },
                        "required": [
                          "cubicBezier"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "spring": {
                            "type": "object",
                            "properties": {
                              "stiffness": {
                                "default": 170,
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 10000
                              },
                              "damping": {
                                "default": 26,
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 1000
                              },
                              "mass": {
                                "default": 1,
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 100
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "spring"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "steps": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 240
                          },
                          "jump": {
                            "default": "end",
                            "type": "string",
                            "enum": [
                              "start",
                              "end"
                            ]
                          }
                        },
                        "required": [
                          "steps"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "easing"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "curves"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "title",
        "kind",
        "body"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "kind": {
          "type": "string",
          "const": "behavior"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "body": {
          "type": "object",
          "properties": {
            "behavior": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "behavior"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "title",
        "kind",
        "body"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://unpkg.com/@adityadeokar/velora/schemas/preset.schema.json",
  "title": "Velora project preset (src/velora/presets/<id>.preset.json)"
}
