{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "width": {
      "type": "integer",
      "minimum": 64,
      "maximum": 3840,
      "multipleOf": 2
    },
    "height": {
      "type": "integer",
      "minimum": 64,
      "maximum": 3840,
      "multipleOf": 2
    },
    "fps": {
      "default": 30,
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 50
        },
        {
          "type": "number",
          "const": 60
        },
        {
          "type": "number",
          "const": 120
        }
      ]
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "recipe": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "startMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 120000
          },
          "durationMs": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120000
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "cut",
                  "dissolve",
                  "slide-push",
                  "wipe-mask",
                  "iris-mask",
                  "depth-dolly",
                  "focus-pull",
                  "cascade-handoff"
                ]
              },
              "durationMs": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30000
              }
            },
            "required": [
              "type",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "recipe",
          "startMs",
          "durationMs"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "default": [],
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "font"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "startMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 120000
          },
          "offsetMs": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 120000
          },
          "gain": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "fadeInMs": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 30000
          },
          "fadeOutMs": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 30000
          },
          "duckUnder": {
            "type": "object",
            "properties": {
              "trackId": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "trackId",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "assetId",
          "startMs"
        ],
        "additionalProperties": false
      }
    },
    "captions": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "burnIn": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "seed": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "width",
    "height",
    "scenes"
  ],
  "additionalProperties": false,
  "$id": "https://unpkg.com/@adityadeokar/velora/schemas/composition.schema.json",
  "title": "Velora composition (<id>.composition.json)"
}
