{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@adityadeokar/velora": ["./src/index.ts"],
      "@adityadeokar/velora/three": ["./src/three/index.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.performance.config.ts",
    "vite.lib.config.ts",
    "vite.cli.config.ts",
    "app",
    "vite.test.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/agent/demo-*/host",
    "tests/examples"
  ]
}
