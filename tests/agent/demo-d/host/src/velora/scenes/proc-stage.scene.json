            { "timeMs": 900, "value": 0 }
          ]
        },
        {
          "target": { "kind": "surface", "id": "orb-b" },
          "property": "z",
          "keyframes": [
            { "timeMs": 0, "value": -300 },
            { "timeMs": 150, "value": -300 },
            { "timeMs": 1050, "value": 0 }
          ]
        },
        {
          "target": { "kind": "surface", "id": "orb-c" },
          "property": "z",
          "keyframes": [
            { "timeMs": 0, "value": -300 },
            { "timeMs": 300, "value": -300 },
            { "timeMs": 1200, "value": 0 }
          ]
        },
        {
          "target": { "kind": "surface", "id": "orb-a" },
          "property": "opacity",
          "keyframes": [
            { "timeMs": 0, "value": 0 },
            { "timeMs": 900, "value": 1 }
          ]
