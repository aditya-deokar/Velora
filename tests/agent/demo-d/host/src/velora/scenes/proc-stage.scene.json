        {
          "target": { "kind": "surface", "id": "orb-b" },
          "property": "opacity",
          "keyframes": [
            { "timeMs": 0, "value": 0 },
            { "timeMs": 150, "value": 0 },
            { "timeMs": 1050, "value": 1 }
          ]
        },
        {
          "target": { "kind": "surface", "id": "orb-c" },
          "property": "opacity",
          "keyframes": [
            { "timeMs": 0, "value": 0 },
            { "timeMs": 300, "value": 0 },
            { "timeMs": 1200, "value": 1 }
          ]
        }
      ]
