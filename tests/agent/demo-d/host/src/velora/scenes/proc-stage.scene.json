{
  "version": 1,
  "id": "proc-stage",
  "title": "Seeded procedural stage",
  "definition": {
    "width": 320,
    "height": 200,
    "scene": {
      "camera": { "perspective": 1400 },
      "focus": { "distance": 1400, "fStop": 8, "focalLength": 50, "maxBlur": 6 },
      "nodes": [{ "id": "orb-a" }, { "id": "orb-b" }, { "id": "orb-c" }]
