{
  "id": "product-orbit",
  "version": 1,
  "title": "Product orbit",
  "description": "A procedural glTF product, animated finish, and live DOM caption under the same camera.",
  "definition": {
    "width": 640,
    "height": 360,
    "scene": {
      "camera": {
        "perspective": 650
      },
      "focus": {
        "distance": 650,
        "maxBlur": 0.6,
        "fStop": 16
      },
      "nodes": [
        {
          "id": "product-world"
        },
        {
          "id": "product-caption"
        }
      ],
      "constraints": [
        {
          "kind": "lookAt",
          "target": {
            "point": [
              0,
              0,
              0
            ]
          }
        },
        {
          "kind": "focusFollow",
          "target": {
            "surface": "product-caption"
          }
        }
      ]
    },
    "motion": {
      "durationMs": 3000,
      "speed": 1,
      "tracks": [
        {
          "target": {
            "kind": "camera"
          },
          "property": "x",
          "keyframes": [
            {
              "timeMs": 0,
              "value": -135
            },
            {
              "timeMs": 3000,
              "value": 135
            }
          ]
        },
        {
          "target": {
            "kind": "camera"
          },
          "property": "y",
          "keyframes": [
            {
              "timeMs": 0,
              "value": -25
            },
            {
              "timeMs": 3000,
              "value": 25
            }
          ]
        },
        {
          "target": {
            "kind": "camera"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": -24
            },
            {
              "timeMs": 3000,
              "value": -24
            }
          ]
        },
        {
          "target": {
            "kind": "channel",
            "id": "three:hero-mesh.roughness"
          },
          "property": "value",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 0.18
            },
            {
              "timeMs": 3000,
              "value": 0.42
            }
          ]
        },
        {
          "target": {
            "kind": "channel",
            "id": "three:hero-mesh.color"
          },
          "property": "value",
          "keyframes": [
            {
              "timeMs": 0,
              "value": "#2b9dbe"
            },
            {
              "timeMs": 3000,
              "value": "#c0a66b"
            }
          ]
        },
        {
          "target": {
            "kind": "channel",
            "id": "three:product.turn.time"
          },
          "property": "value",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 0
            },
            {
              "timeMs": 3000,
              "value": 1
            }
          ]
        },
        {
          "target": {
            "kind": "channel",
            "id": "three:product.turn.weight"
          },
          "property": "value",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 1
            },
            {
              "timeMs": 3000,
              "value": 1
            }
          ]
        }
      ]
    }
  }
}
