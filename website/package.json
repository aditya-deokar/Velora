{
  "name": "velora-website",
  "private": true,
  "version": "1.0.0",
  "description": "Velora docs site: getting started, template gallery, cookbook, craft guides and generated CLI/schema reference. Never part of the npm package.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "predev": "npm run generate",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@adityadeokar/velora": "file:..",
    "@vitejs/plugin-react": "5.1.0",
    "vite": "7.3.6"
  }
}
